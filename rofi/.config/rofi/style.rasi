* {
    bg:             rgba(3, 16, 20, 0.90);
    panel:          rgba(8, 36, 43, 0.86);
    panel-hi:       rgba(13, 52, 64, 0.96);
    border:         rgba(34, 211, 238, 0.16);
    border-hi:      rgba(34, 211, 238, 0.42);
    text:           #d6faff;
    muted:          #7aa4ad;
    blue:           #22d3ee;
    teal:           #67e8f9;
    red:            #ff5f6d;

    width:          640px;
    font:           "FiraCode Nerd Font 13";
}

element-text,
element-icon,
mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    transparency: "real";
    height: 420px;
    border: 1px;
    border-color: @border;
    border-radius: 18px;
    background-color: @bg;
}

mainbox {
    padding: 14px;
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 8px;
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    background-color: @panel;
}

prompt {
    padding: 7px 12px;
    border-radius: 10px;
    background-color: @blue;
    text-color: #031014;
}

entry {
    padding: 7px 4px;
    background-color: transparent;
    text-color: @text;
    placeholder-color: @muted;
}

listview {
    columns: 2;
    lines: 5;
    spacing: 8px;
    border: 0;
    background-color: transparent;
}

element {
    padding: 9px;
    spacing: 10px;
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    background-color: transparent;
    text-color: @muted;
}

element-icon {
    size: 26px;
}

element selected {
    border-color: @border-hi;
    background-color: @panel-hi;
    text-color: @text;
}

element selected element-icon {
    text-color: @teal;
}

mode-switcher {
    spacing: 8px;
    background-color: transparent;
}

button {
    padding: 8px 12px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @panel;
    text-color: @muted;
}

button selected {
    border-color: @border-hi;
    background-color: @panel-hi;
    text-color: @blue;
}

message {
    padding: 8px;
    border: 1px;
    border-color: rgba(255, 95, 109, 0.35);
    border-radius: 12px;
    background-color: rgba(255, 95, 109, 0.12);
}

textbox {
    padding: 6px;
    background-color: transparent;
    text-color: @red;
}
