* {
    bg:             rgba(0, 5, 7, 0.94);
    panel:          rgba(3, 17, 22, 0.91);
    panel-hi:       rgba(5, 34, 42, 0.97);
    border:         rgba(0, 190, 220, 0.18);
    border-hi:      rgba(0, 190, 220, 0.44);
    text:           #d9f7fb;
    muted:          #6f9299;
    blue:           #00c2df;
    teal:           #00e5ff;
    red:            #d93a18;

    width:          640px;
    font:           "FiraCode Nerd Font 13";
}

element-text,
element-icon,
mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    transparency: "real";
    height: 420px;
    border: 1px;
    border-color: @border;
    border-radius: 18px;
    background-color: @bg;
}

mainbox {
    padding: 14px;
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [prompt, entry];
    spacing: 10px;
    padding: 8px;
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    background-color: @panel;
}

prompt {
    padding: 7px 12px;
    border-radius: 10px;
    background-color: @blue;
    text-color: #000507;
}

entry {
    padding: 7px 4px;
    background-color: transparent;
    text-color: @text;
    placeholder-color: @muted;
}

listview {
    columns: 2;
    lines: 5;
    spacing: 8px;
    border: 0;
    background-color: transparent;
}

element {
    padding: 9px;
    spacing: 10px;
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    background-color: transparent;
    text-color: @muted;
}

element-icon {
    size: 26px;
}

element selected {
    border-color: @border-hi;
    background-color: @panel-hi;
    text-color: @text;
}

element selected element-icon {
    text-color: @teal;
}

mode-switcher {
    spacing: 8px;
    background-color: transparent;
}

button {
    padding: 8px 12px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @panel;
    text-color: @muted;
}

button selected {
    border-color: @border-hi;
    background-color: @panel-hi;
    text-color: @blue;
}

message {
    padding: 8px;
    border: 1px;
    border-color: rgba(217, 58, 24, 0.40);
    border-radius: 12px;
    background-color: rgba(217, 58, 24, 0.14);
}

textbox {
    padding: 6px;
    background-color: transparent;
    text-color: @red;
}
